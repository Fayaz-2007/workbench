# Sovereign AI Workbench — backend environment configuration
#
# Copy this file to .env and adjust for your environment. Never commit
# a real .env file, and never place external AI API keys here — this
# system is designed to run entirely on local infrastructure. Every
# *_BASE_URL below must stay loopback/LAN; nothing in this app calls out
# to the public internet at runtime.

APP_NAME="Sovereign AI Workbench"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API (the frontend
# dev server by default; add the LAN URL judges/operators will use, e.g.
# http://SERVER-IP:5173).
CORS_ORIGINS=http://localhost:5173

# This machine's resource tier: tiny | small | medium | large. Used by the
# Model Router to prefer models that actually fit the current hardware
# (see app/models/router.py). The dev machine (4c/8t, ~12GB RAM, no CUDA
# GPU) is "small".
SERVER_RESOURCE_CLASS=small

# ---------------------------------------------------------------------------
# Real local model inference (Phase A — app/models/providers/ollama.py)
# ---------------------------------------------------------------------------
# "mock" (default) registers only the metadata-only dev models, so the test
# suite stays deterministic regardless of what's running on the host. Set
# to "ollama" to also register real, Ollama-served models — requires
# `ollama serve` running locally with MODEL below already pulled
# (`ollama pull qwen2.5:1.5b-instruct`).
MODEL_PROVIDER=mock
MODEL_BASE_URL=http://localhost:11434
MODEL_REQUEST_TIMEOUT_SECONDS=60
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# ---------------------------------------------------------------------------
# Real local vision inference (Vision Agent — app/models/providers/ollama_vision.py)
# ---------------------------------------------------------------------------
# Separate from MODEL_PROVIDER/OLLAMA_MODEL above: the text model has no
# multimodal capability. "mock" (default) keeps Vision Agent on the
# metadata-only dev model, so the test suite stays deterministic. Set to
# "ollama" for real local image understanding — requires
# `ollama pull qwen2.5vl:3b` (or another vision-capable Ollama model) and
# reuses MODEL_BASE_URL above (same Ollama server, different model).
VISION_MODEL_PROVIDER=mock
VISION_MODEL=qwen2.5vl:3b

# ---------------------------------------------------------------------------
# RAG / local knowledge base (Phase B — app/rag/)
# ---------------------------------------------------------------------------
# "mock" (default) uses a deterministic, dependency-free hash embedding —
# keeps the RAG test suite offline. Set to "ollama" for real local
# embeddings (requires `ollama pull nomic-embed-text`).
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=nomic-embed-text
CHROMA_PATH=./data/chroma
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4

# ---------------------------------------------------------------------------
# Local storage (Phase B/G)
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
DOCUMENTS_DIR=./data/documents
GENERATED_DIR=./data/generated
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# OCR (Phase C — app/multimodal/ocr.py)
# ---------------------------------------------------------------------------
# "tesseract" requires the tesseract *binary* on PATH, not just the Python
# package (see https://github.com/tesseract-ocr/tesseract). Cleanly reports
# unavailable when missing rather than failing ingestion. "none" disables
# OCR outright.
OCR_PROVIDER=tesseract

# ---------------------------------------------------------------------------
# Sandboxed code execution (Phase F — app/sandbox/)
# ---------------------------------------------------------------------------
# "subprocess" is a *development* sandbox (isolated cwd + timeout; NOT
# container/VM isolation — see app/sandbox/base.py). "none" disables code
# execution; Code Agent then just returns generated code without running it.
SANDBOX_PROVIDER=subprocess
MAX_EXECUTION_SECONDS=15

# ---------------------------------------------------------------------------
# Bounded agentic loop (Code Agent's generate -> sandbox -> revise cycle)
# ---------------------------------------------------------------------------
MAX_AGENT_STEPS=8

# --- Reserved for later segments (not yet read by the application) ---
# DATABASE_URL=
